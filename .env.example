MESHCORE_PORT=/dev/ttyACM0
OPENWEATHERMAP_API_KEY=
WEATHER_CITY=Omsk
WEATHER_CHANNEL_IDX=3
WEATHER_HOUR=7
WEATHER_MINUTE=30
WEATHER_TIMEZONE_OFFSET=6
TRAFFIC_CHANNEL_IDX=3
TRAFFIC_INTERVAL_MINUTES=5
TRAFFIC_HOUR_FROM=7
TRAFFIC_HOUR_TO=19
VERSIONS_CHANNEL_IDX=3
VERSIONS_HOUR_FROM=7
VERSIONS_HOUR_TO=19
# Интервалы: число с суффиксом m (минуты), h (часы), d (сутки). 0 — не проверять
VERSIONS_MESHCORE_INTERVAL=24h
VERSIONS_EASYSKYMESH_INTERVAL=24h
VERSIONS_APP_INTERVAL=24h
VERSIONS_OMMESH_INTERVAL=24h
MOON_LAT=54.9914
MOON_LON=73.3645
MAX_CHANNEL_IDX=10
ADVERT_INTERVAL_MINUTES=30
ADVERT_FLOOD_INTERVAL_HOURS=6
# Подробные логи сырых payload'ов (RX_LOG, входящие сообщения): 1 — включить
LOG_VERBOSE=0
