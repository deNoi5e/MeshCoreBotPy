MESHCORE_PORT=/dev/ttyACM0

# Переподключение при обрыве связи по COM-порту: столько попыток подряд с таким
# интервалом (секунды), после чего бот останавливается
RECONNECT_ATTEMPTS=10
RECONNECT_DELAY_SECONDS=15

# Подробные логи сырых payload'ов (RX_LOG, входящие сообщения): 1 — включить
LOG_VERBOSE=0
# Сколько суток хранить файлы bot_*.log (чистятся при старте бота): 0 — не удалять
LOG_KEEP_DAYS=7

MAX_CHANNEL_IDX=10

ADVERT_INTERVAL_MINUTES=30
ADVERT_FLOOD_INTERVAL_HOURS=6

# Удаление с ноды контактов, которых не слышно дольше N суток (избранные не трогаются):
# при старте и затем с интервалом 30m/2h/7d. 0 в любом из параметров отключает чистку
CONTACTS_MAX_AGE_DAYS=30
CONTACTS_CLEANUP_INTERVAL=7d

OPENWEATHERMAP_API_KEY=
WEATHER_CITY=Omsk
WEATHER_CHANNEL_IDX=3
WEATHER_HOUR=7
WEATHER_MINUTE=30
WEATHER_TIMEZONE_OFFSET=6

TRAFFIC_CHANNEL_IDX=3
TRAFFIC_INTERVAL_MINUTES=5
TRAFFIC_HOUR_FROM=7
TRAFFIC_HOUR_TO=19
VERSIONS_CHANNEL_IDX=3
VERSIONS_HOUR_FROM=7
VERSIONS_HOUR_TO=19
# Второй канал для новых версий: версия и короткая (v.gd, при сбое — da.gd) ссылка на скачивание;
# не сократилась — полная ссылка вторым сообщением.
# Не задан — ссылки не рассылаются
#VERSIONS_LINK_CHANNEL_IDX=4
# Для проверки: эти источники (через запятую) при каждом старте бота отправляют
# текущую версию и ссылку в VERSIONS_LINK_CHANNEL_IDX (не в основной канал)
# без проверки изменения и окна. Пусто — выключено
#VERSIONS_ANNOUNCE_ON_START=ommesh

# Интервалы: число с суффиксом m (минуты), h (часы), d (сутки). 0 — не проверять
VERSIONS_MESHCORE_INTERVAL=24h
VERSIONS_EASYSKYMESH_INTERVAL=24h
VERSIONS_APP_INTERVAL=24h
VERSIONS_OMMESH_INTERVAL=24h
VERSIONS_YAZIFW_INTERVAL=24h

MOON_LAT=54.9914
MOON_LON=73.3645
