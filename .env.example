MESHCORE_CONNECTION=ble
MESHCORE_PORT=/dev/ttyACM0
MESHCORE_BLE_ADDRESS=E1:60:F1:91:09:2A
# PIN для BLE подключения (оставьте пустым если PIN не используется)
MESHCORE_BLE_PIN=
MESHCORE_TCP_HOST=192.168.1.100
MESHCORE_TCP_PORT=4000
NARODMON_API_KEY=
# Датчики народмон: ID,"метка",ID,"метка",...
NARODMON_SENSORS=D1291,"БЛПК",D5694,"22мкрн"
WEATHER_CITY=Omsk
WEATHER_CHANNEL_IDX=3
WEATHER_HOUR=7
WEATHER_MINUTE=30
WEATHER_TIMEZONE_OFFSET=6
# Периодичность отправки погоды в канал:
# 0    - отключено
# 1d   - раз в день в WEATHER_HOUR:WEATHER_MINUTE
# 1h..12h - каждые N часов
WEATHER_BROADCAST_PERIOD=1d
# Источник периодической погоды в канал: owm (OpenWeatherMap) или yandex
WEATHER_SOURCE=owm
# Яндекс Погода API (команда /yapogoda, /yaprognoz)
YANDEX_WEATHER_API_KEY=
YANDEX_WEATHER_LAT=55.75
YANDEX_WEATHER_LON=37.62
# Включение/отключение автоответов из answers.txt (true/false)
ANSWERS_ENABLED=true
# Telegram relay — пересылка сообщений из MeshCore канала в Telegram
# TG_RELAY_ENABLED=true включает пересылку
# TG_CHAT_ID — ID группы (например -1001234567890)
# TG_TOPIC_ID — ID топика в группе (оставьте пустым если без топика)
# TG_RELAY_CHANNEL — номер канала MeshCore для пересылки (по умолчанию 0)
TG_RELAY_ENABLED=false
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_TOPIC_ID=
TG_RELAY_CHANNEL=0
# Канал MeshCore для отправки сообщений из Telegram (сообщения начинающиеся с *)
TG_TO_MESH_CHANNEL=0
# Прокси для Telegram бота:
# TG_PROXY_TYPE=none     — без прокси (по умолчанию)
# TG_PROXY_TYPE=socks5   — SOCKS5 прокси (TG_PROXY_HOST, TG_PROXY_PORT, опционально USER/PASS)
# TG_PROXY_TYPE=socks4   — SOCKS4 прокси (TG_PROXY_HOST, TG_PROXY_PORT, опционально USER)
# TG_PROXY_TYPE=http     — HTTP CONNECT прокси (TG_PROXY_HOST, TG_PROXY_PORT, опционально USER/PASS)
# TG_PROXY_TYPE=mtproto  — MTProto прокси (TG_PROXY_URL) — требует запуска mtProto_to_socks5.py
TG_PROXY_TYPE=none
TG_PROXY_URL=
TG_PROXY_HOST=
TG_PROXY_PORT=
TG_PROXY_USER=
TG_PROXY_PASS=
# Логин и пароль для SOCKS5 прокси (оставьте пустыми если не нужны)
TG_PROXY_USER=
TG_PROXY_PASS=
# Telegram relay: пересылка сообщений из канала MeshCore в Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_TOPIC_ID=
# Номер канала MeshCore для пересылки (по умолчанию 0 = public)
TELEGRAM_MESHCORE_CHANNEL=0
