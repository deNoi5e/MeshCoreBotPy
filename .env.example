MESHCORE_PORT=/dev/ttyACM0
OPENWEATHERMAP_API_KEY=
WEATHER_CITY=Omsk
WEATHER_CHANNEL_IDX=3
WEATHER_HOUR=7
WEATHER_MINUTE=30
WEATHER_TIMEZONE_OFFSET=6
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_IDX=

# Чтение чужого публичного Telegram-канала через user-аккаунт (Telethon).
# API_ID/API_HASH — с https://my.telegram.org/apps, НЕ токен бота.
# Сессия создаётся один раз: python scripts/telegram_login.py
#
# Пример — оповещения МЧС Омской области об угрозе БПЛА в отдельный канал:
#   TELEGRAM_SOURCE_CHANNEL=@mchs_omsk
#   TELEGRAM_USERFEED_CHANNEL_IDX=<idx отдельного канала тревог>
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_SESSION=telegram_user.session
TELEGRAM_SOURCE_CHANNEL=
TELEGRAM_USERFEED_CHANNEL_IDX=
